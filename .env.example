# Required: application
# Safe defaults: NODE_ENV=local, PORT=3000
APP_NAME=opportunity-os
NODE_ENV=local
PORT=3000

# Required: local services
DATABASE_URL=postgresql://opportunity_os:opportunity_os@localhost:5432/opportunity_os
REDIS_URL=redis://localhost:6379

# Required: AI providers
# API keys are secrets and intentionally have no example value.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_MODEL=claude-3-5-sonnet

# Required: authentication
# JWT_SECRET is a secret and intentionally has no example value.
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Required: observability
# Safe default: LOG_LEVEL=info
LOG_LEVEL=info
OTEL_EXPORTER_ENDPOINT=http://localhost:4318

# Optional: external monitoring and AI observability
SENTRY_DSN=
LANGFUSE_API_KEY=
LANGSMITH_API_KEY=

# Optional: hosted external MVP runtime
# These values are bound by the deployment platform for hosted trials.
OPPORTUNITY_OS_API_URL=http://127.0.0.1:4000
OPPORTUNITY_OS_WEB_URL=http://127.0.0.1:3000
NEXT_PUBLIC_OPPORTUNITY_OS_API_BASE_URL=http://127.0.0.1:4000
API_PERSISTENCE_MODE=memory
# Optional private-pilot gate for live scan requests. Keep secret in API hosting only.
API_LIVE_SCAN_ACCESS_TOKEN=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_LIVE_ANALYSIS_ENABLED=false
LLM_PROVIDER_TIMEOUT_MS=30000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: controlled live Reddit provider development
# Default tests do not use these values. Set REDDIT_LIVE_TEST_ENABLED=true only
# when intentionally running the opt-in live Reddit dev command or integration test.
# Hosted production environments should prefer the REDDIT_PRODUCTION_* names.
REDDIT_PRODUCTION_CLIENT_ID=
REDDIT_PRODUCTION_CLIENT_SECRET=
REDDIT_PRODUCTION_REFRESH_TOKEN=
REDDIT_PRODUCTION_USER_AGENT=OpportunityOS/0.0.0 external-mvp
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_USER_AGENT=OpportunityOS/0.0.0 local-dev
REDDIT_LIVE_TEST_ENABLED=false
REDDIT_LIVE_SUBREDDIT=entrepreneur
REDDIT_LIVE_LIMIT=5

# Optional: official Stack Exchange read-only datasource
# Fixture mode remains the default. An application key improves quota isolation but
# must be configured only in local/hosted secret storage.
STACK_EXCHANGE_LIVE_SCAN_ENABLED=false
STACK_EXCHANGE_API_BASE_URL=https://api.stackexchange.com/2.3
STACK_EXCHANGE_DEFAULT_SITE=stackoverflow
STACK_EXCHANGE_API_KEY=
STACK_EXCHANGE_TIMEOUT_MS=10000
STACK_EXCHANGE_QUERY=manual deployment
