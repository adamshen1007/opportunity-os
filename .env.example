# Required: application
APP_NAME=opportunity-os
NODE_ENV=development
PORT=3000

# Required: local services
DATABASE_URL=postgresql://opportunity_os:opportunity_os@localhost:5432/opportunity_os
REDIS_URL=redis://localhost:6379

# Required before AI-backed implementation work runs
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=
ANTHROPIC_MODEL=

# Required before authenticated application surfaces run
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Required: observability
LOG_LEVEL=info
OTEL_EXPORTER_ENDPOINT=

# Optional: external monitoring and AI observability
SENTRY_DSN=
LANGFUSE_API_KEY=
LANGSMITH_API_KEY=
