{
  "name": "@opportunity-os/connectors-stack-exchange",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only Stack Exchange connector for Opportunity OS.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "dev:stack-exchange:live": "pnpm build && node dist/provider/live-smoke.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src --passWithNoTests"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.7.0"
  },
  "dependencies": {
    "@opportunity-os/connectors": "workspace:*",
    "@opportunity-os/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "vitest": "^4.0.16"
  }
}
