generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PrivateBetaInvite {
  id             String               @id
  email          String               @unique
  inviteCodeHash String               @unique
  status         String
  createdAt      DateTime             @default(now())
  expiresAt      DateTime?
  acceptedAt     DateTime?
  revokedAt      DateTime?
  sessions       PrivateBetaSession[]

  @@map("private_beta_invites")
}

model PrivateBetaSession {
  id          String                 @id
  tokenHash   String                 @unique
  inviteId    String
  principalId String
  status      String
  createdAt   DateTime               @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  invite      PrivateBetaInvite      @relation(fields: [inviteId], references: [id])
  feedback    PrivateBetaFeedback[]
  bugReports  PrivateBetaBugReport[]

  @@index([inviteId])
  @@index([principalId])
  @@map("private_beta_sessions")
}

model PrivateBetaFeedback {
  id                  String                      @id
  sessionId           String?
  opportunityId       String
  opportunityRecordId String?
  ownerPrincipalId    String
  status              String
  reasonCategories    Json
  ratings             Json
  safeMetadata        Json?
  createdAt           DateTime                    @default(now())
  session             PrivateBetaSession?         @relation(fields: [sessionId], references: [id])
  opportunityRecord   GeneratedOpportunityRecord? @relation(fields: [opportunityRecordId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([opportunityId])
  @@index([opportunityRecordId])
  @@index([ownerPrincipalId])
  @@map("private_beta_feedback")
}

model PrivateBetaBugReport {
  id              String              @id
  sessionId       String?
  title           String
  safeDescription String
  severity        String
  status          String
  safeMetadata    Json?
  createdAt       DateTime            @default(now())
  session         PrivateBetaSession? @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@map("private_beta_bug_reports")
}

model ScanRunRecord {
  id               String                     @id
  ownerPrincipalId String
  mode             String
  status           String
  source           Json
  stages           Json
  safeMetadata     Json?
  result           Json?
  startedAt        DateTime
  completedAt      DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  rawSourceContent RawSourceContent[]
  rankingResults   OpportunityRankingResult[]

  @@index([mode])
  @@index([status])
  @@index([startedAt])
  @@index([ownerPrincipalId])
  @@map("scan_run_records")
}

model RawSourceContent {
  id                 String              @id
  scanId             String
  sourcePlatform     String
  sourceId           String
  sourceType         String
  sourceUrl          String?
  title              String?
  bodyText           String?
  authorReference    String?
  communityReference String?
  contentHash        String?
  capturedAt         DateTime
  safeMetadata       Json?
  provenance         Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  normalizedContent  NormalizedContent[]
  scan               ScanRunRecord       @relation(fields: [scanId], references: [id])

  @@unique([scanId, sourcePlatform, sourceId])
  @@index([scanId])
  @@index([sourcePlatform])
  @@index([sourceType])
  @@index([contentHash])
  @@map("raw_source_content")
}

model NormalizedContent {
  id                 String           @id
  rawSourceContentId String
  canonicalText      String
  languageCode       String?
  contentHash        String?
  textSegments       Json
  safeMetadata       Json?
  provenance         Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  rawSourceContent   RawSourceContent @relation(fields: [rawSourceContentId], references: [id], onDelete: Cascade)
  analysisResults    AnalysisResult[]

  @@index([rawSourceContentId])
  @@index([languageCode])
  @@index([contentHash])
  @@map("normalized_content")
}

model AnalysisResult {
  id                     String                       @id
  normalizedContentId    String
  analysisType           String
  analysisVersion        String
  status                 String
  structuredOutput       Json
  evidence               Json?
  confidence             Json?
  safeMetadata           Json?
  provenance             Json?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  normalizedContent      NormalizedContent            @relation(fields: [normalizedContentId], references: [id], onDelete: Cascade)
  candidateOpportunities CandidateOpportunityRecord[]

  @@index([normalizedContentId])
  @@index([analysisType])
  @@index([status])
  @@map("analysis_results")
}

model CandidateOpportunityRecord {
  id                     String                       @id
  analysisResultId       String?
  title                  String
  summary                String
  hypothesis             Json
  evidence               Json
  confidence             Json?
  lifecycleStatus        String
  safeMetadata           Json?
  provenance             Json?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  analysisResult         AnalysisResult?              @relation(fields: [analysisResultId], references: [id], onDelete: SetNull)
  generatedOpportunities GeneratedOpportunityRecord[]

  @@index([analysisResultId])
  @@index([lifecycleStatus])
  @@map("candidate_opportunity_records")
}

model GeneratedOpportunityRecord {
  id                     String                      @id
  candidateOpportunityId String?
  title                  String
  summary                String
  hypothesis             Json
  evidence               Json
  confidence             Json?
  score                  Json?
  generationVersion      String
  lifecycleStatus        String
  safeMetadata           Json?
  provenance             Json?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  candidateOpportunity   CandidateOpportunityRecord? @relation(fields: [candidateOpportunityId], references: [id], onDelete: SetNull)
  rankingItems           OpportunityRankingItem[]
  feedback               PrivateBetaFeedback[]

  @@index([candidateOpportunityId])
  @@index([generationVersion])
  @@index([lifecycleStatus])
  @@map("generated_opportunity_records")
}

model OpportunityRankingResult {
  id             String                   @id
  scanId         String
  rankingVersion String
  status         String
  generatedAt    DateTime
  safeMetadata   Json?
  provenance     Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  items          OpportunityRankingItem[]
  scan           ScanRunRecord            @relation(fields: [scanId], references: [id])

  @@index([scanId])
  @@index([rankingVersion])
  @@index([status])
  @@map("opportunity_ranking_results")
}

model OpportunityRankingItem {
  id                     String                     @id
  rankingResultId        String
  generatedOpportunityId String
  rankPosition           Int
  score                  Json
  explanation            Json
  safeMetadata           Json?
  createdAt              DateTime                   @default(now())
  rankingResult          OpportunityRankingResult   @relation(fields: [rankingResultId], references: [id], onDelete: Cascade)
  generatedOpportunity   GeneratedOpportunityRecord @relation(fields: [generatedOpportunityId], references: [id], onDelete: Cascade)

  @@unique([rankingResultId, generatedOpportunityId])
  @@unique([rankingResultId, rankPosition])
  @@index([generatedOpportunityId])
  @@map("opportunity_ranking_items")
}
