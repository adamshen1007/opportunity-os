{
  "name": "@opportunity-os/database",
  "version": "0.0.0",
  "private": true,
  "description": "Database foundation package for Opportunity OS shared infrastructure.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "prisma --config=./prisma.config.ts generate && tsc -p tsconfig.json",
    "lint": "prisma --config=./prisma.config.ts generate && tsc --noEmit -p tsconfig.json",
    "migrate:deploy": "prisma --config=./prisma.config.ts migrate deploy",
    "migrate:dev": "prisma --config=./prisma.config.ts migrate dev",
    "migrate:status": "prisma --config=./prisma.config.ts migrate status",
    "prisma": "prisma --config=./prisma.config.ts",
    "test": "prisma --config=./prisma.config.ts generate && vitest run src --passWithNoTests",
    "verify:local": "prisma --config=./prisma.config.ts migrate status",
    "verify:migrations:staging": "node scripts/verify-production-migrations.mjs staging",
    "verify:migrations:clean": "node scripts/verify-production-migrations.mjs clean",
    "verify:migrations:backup": "node scripts/verify-production-migrations.mjs backup",
    "verify:restore": "node scripts/verify-restored-database.mjs"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.22.0"
  }
}
